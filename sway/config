# ==============================================================================
# 1. ENVIRONMENT & AUTOSTART
# ==============================================================================
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec noctalia

include /etc/sway/config.d/*

# ==============================================================================
# 2. VARIABLES & APPEARANCE
# ==============================================================================
set $mod Mod4
set $term alacritty
set $menu wmenu-run

# Vim-style direction keys
set $left h
set $down j
set $up k
set $right l

default_border pixel 2

# ==============================================================================
# 3. DISPLAYS & OUTPUTS
# ==============================================================================
output HDMI-A-1 resolution 2560x1440 position 0,0
output DP-3     resolution 1920x1080 position 2560,0

# ==============================================================================
# 4. INPUT DEVICES
# ==============================================================================
input type:keyboard {
    xkb_layout "pl"
}

input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    pointer_accel 0.8
    accel_profile "flat"
}

input type:pointer {
    accel_profile flat
}

input "2:10:TPPS/2_Elan_TrackPoint" {
    pointer_accel 1.0
    accel_profile "flat"
}

# ==============================================================================
# 5. CORE SYSTEM & APPLICATION SHORTCUTS
# ==============================================================================
# App Launchers
bindsym $mod+z exec $term
bindsym $mod+a exec noctalia msg panel-toggle launcher
bindsym $mod+f exec firefox

# Wallpaper
exec_always swaymsg output "*" bg "$(find ~/wallpapers -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" \) | shuf -n 1)" fill

# Window Actions
bindsym $mod+q kill

# Session & Reload
bindsym $mod+Shift+e reload
bindsym $mod+Shift+q exec swaynag -t warning -m 'Exit Sway?' -B 'Yes, exit sway' 'swaymsg exit'

# Screenshots
bindsym Print exec grim
bindsym --release $mod+Shift+s exec --no-startup-id 'grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot" "Selection copied to clipboard!"'
bindsym --release $mod+Ctrl+s  exec --no-startup-id 'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png && notify-send "Screenshot" "Selection saved to file!"'
bindsym --release $mod+Shift+m exec --no-startup-id ~/dotfiles/scripts/screenshot.sh clipboard
bindsym --release $mod+Ctrl+m  exec --no-startup-id ~/dotfiles/scripts/screenshot.sh file

# ==============================================================================
# 6. FOCUS & WINDOW NAVIGATION
# ==============================================================================
# Change focus (Vim keys)
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

# Change focus (Arrow keys)
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# Move focused window (Vim keys)
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

# Move focused window (Arrow keys)
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

# Floating / Tiling / Fullscreen
floating_modifier $mod normal
bindsym $mod+Shift+space   floating toggle
bindsym $mod+space         focus mode_toggle
bindsym Mod1+Return        fullscreen toggle

# ==============================================================================
# 7. WORKSPACES & MONITORS
# ==============================================================================
# Workspace monitor assignments
workspace 1  output HDMI-A-1
workspace 2  output HDMI-A-1
workspace 3  output HDMI-A-1
workspace 4  output HDMI-A-1
workspace 5  output HDMI-A-1
workspace 6  output HDMI-A-1
workspace 7  output HDMI-A-1
workspace 8  output HDMI-A-1
workspace 9  output HDMI-A-1
workspace 10 output HDMI-A-1

workspace "11:1"   output DP-3
workspace "12:2"   output DP-3
workspace "13:3"   output DP-3
workspace "14:4"   output DP-3
workspace "15:5"   output DP-3
workspace "16:6"   output DP-3
workspace "17:7"   output DP-3
workspace "18:8"   output DP-3
workspace "19:9"   output DP-3
workspace "110:10" output DP-3

# Monitor Switching
bindsym Mod1+Tab exec ~/dotfiles/scripts/ws.sh toggle_monitor
bindsym $mod+m   exec ~/dotfiles/scripts/move_to_other_monitor.sh

# Switch to workspace
bindsym $mod+1 exec ~/dotfiles/scripts/ws.sh workspace 1
bindsym $mod+2 exec ~/dotfiles/scripts/ws.sh workspace 2
bindsym $mod+3 exec ~/dotfiles/scripts/ws.sh workspace 3
bindsym $mod+4 exec ~/dotfiles/scripts/ws.sh workspace 4
bindsym $mod+5 exec ~/dotfiles/scripts/ws.sh workspace 5
bindsym $mod+6 exec ~/dotfiles/scripts/ws.sh workspace 6
bindsym $mod+7 exec ~/dotfiles/scripts/ws.sh workspace 7
bindsym $mod+8 exec ~/dotfiles/scripts/ws.sh workspace 8
bindsym $mod+9 exec ~/dotfiles/scripts/ws.sh workspace 9
bindsym $mod+0 exec ~/dotfiles/scripts/ws.sh workspace 10

# Move container to workspace
bindsym $mod+Shift+1 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 1
bindsym $mod+Shift+2 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 2
bindsym $mod+Shift+3 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 3
bindsym $mod+Shift+4 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 4
bindsym $mod+Shift+5 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 5
bindsym $mod+Shift+6 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 6
bindsym $mod+Shift+7 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 7
bindsym $mod+Shift+8 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 8
bindsym $mod+Shift+9 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 9
bindsym $mod+Shift+0 exec ~/dotfiles/scripts/ws.sh "move container to workspace" 10

# ==============================================================================
# 8. LAYOUT & SCRATCHPAD
# ==============================================================================
# Splits & Layout Styles
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

# ==============================================================================
# 9. RESIZE MODE
# ==============================================================================
mode "resize" {
    bindsym $left  resize shrink width 10px
    bindsym $down  resize grow height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left   resize shrink width 10px
    bindsym Down   resize grow height 10px
    bindsym Up     resize shrink height 10px
    bindsym Right  resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ==============================================================================
# 10. HARDWARE & MEDIA KEYS
# ==============================================================================
# Audio (WirePlumber / PipeWire)
bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Media control
bindsym --locked XF86AudioPlay  exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev  exec playerctl previous
bindsym --locked XF86AudioNext  exec playerctl next
bindsym --locked XF86AudioStop  exec playerctl stop

# Brightness
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+
